      "Sound": ["Tone (all slots)", "Motion (all slots)", "Grit (all slots)", "Drive", "Tone CV (10 %/V)"],
      "Rhythm": ["Rhythm on / off", "Variation (rhythm edits)", "Drift (slow tone / motion LFO)"],
      "Low end": ["Split", "Sub", "Duck sidechain"],
      "Key": ["V/OCT", "Gate", "F0 (V/OCT)"],
      "Output": ["Width (above the split)", "Level", "Left", "Right"]
